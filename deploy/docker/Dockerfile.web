# =============================================================================
# KineticFit OS - Hardened Multi-Stage Web SPA Dockerfile
# Multi-stage Vite build into unprivileged Nginx with security headers,
# brotli/gzip pre-compression, and non-root execution.
# =============================================================================

# --- Stage 1: Build Frontend Assets ---
FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @kineticfit/web build

# --- Stage 2: Hardened Unprivileged Nginx Runner ---
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runner

# Remove default server definition
USER root
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy hardened nginx configuration for SPA routing
COPY <<'EOF' /etc/nginx/conf.d/app.conf
server {
    listen 8080 default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security Headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ws: wss: http: https:;" always;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # Static Assets Caching (1 year immutable)
    location ~* \.(?:css|js|woff2?|svg|png|jpg|jpeg|gif|ico|webp)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # SPA Fallback Routing
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Health Probe
    location /health/live {
        access_log off;
        return 200 '{"status":"UP","service":"web"}\n';
        add_header Content-Type application/json;
    }
}
EOF

# Copy compiled SPA static assets
COPY --from=builder --chown=101:101 /app/apps/web/dist /usr/share/nginx/html

USER 101:101
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD curl -f http://localhost:8080/health/live || exit 1

CMD ["nginx", "-g", "daemon off;"]

