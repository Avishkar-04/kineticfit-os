# syntax=docker/dockerfile:1
# =============================================================================
# KineticFit OS - Hardened Multi-Stage Web SPA Dockerfile
# Multi-stage Vite build into unprivileged Nginx with security headers,
# gzip compression, and non-root execution.
# =============================================================================

# --- Stage 1: Build Frontend Assets ---
FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@12.15.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@kineticfit/web...

# --- Stage 2: Hardened Unprivileged Nginx Runner ---
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runner

# Remove default server definition
USER root
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy hardened nginx configuration for SPA routing
COPY deploy/docker/nginx-spa.conf /etc/nginx/conf.d/app.conf

# Copy compiled SPA static assets
COPY --from=builder --chown=101:101 /app/apps/web/dist /usr/share/nginx/html

USER 101:101
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD curl -f http://localhost:8080/health/live || exit 1

CMD ["nginx", "-g", "daemon off;"]
