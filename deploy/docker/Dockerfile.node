# =============================================================================
# KineticFit OS - Hardened Multi-Stage Node.js Microservice Dockerfile
# Pinned slim base, non-root user (UID 10001), dumb-init PID 1 signal handler,
# read-only root filesystem compatible, dropped Linux capabilities.
# =============================================================================

# --- Stage 1: Base & Dependencies ---
FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache dumb-init libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

# --- Stage 2: Build & Prune ---
FROM base AS builder
WORKDIR /app

# Copy dependency specifications for Turborepo / pnpm caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/ ./apps/
COPY db/ ./db/

# Install frozen dependencies
RUN pnpm install --frozen-lockfile

# Build workspace packages and target microservice
ARG APP_NAME
ENV APP_NAME=${APP_NAME}
RUN pnpm run build

# --- Stage 3: Production Minimal Runner ---
FROM node:22-alpine AS runner
WORKDIR /app

RUN apk add --no-cache dumb-init curl \
    && addgroup -g 10001 -S kinetic \
    && adduser -u 10001 -S kinetic -G kinetic

ENV NODE_ENV=production
ENV PORT=3000

# Copy workspace build artifacts
COPY --from=builder --chown=kinetic:kinetic /app/node_modules ./node_modules
COPY --from=builder --chown=kinetic:kinetic /app/packages ./packages
COPY --from=builder --chown=kinetic:kinetic /app/apps ./apps
COPY --from=builder --chown=kinetic:kinetic /app/package.json ./package.json

# Hardened security context
USER 10001:10001

ARG APP_DIR=apps/auth-service
ENV APP_DIR=${APP_DIR}

EXPOSE 3000

# Standardized healthcheck probe
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:${PORT}/health/live || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "dist/server.js"]
