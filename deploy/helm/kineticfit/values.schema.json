{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KineticFitValues",
  "type": "object",
  "required": ["global", "database", "redis", "rabbitmq", "services"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["environment", "domain"],
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        },
        "domain": {
          "type": "string"
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["host", "port", "name", "user"],
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "name": { "type": "string" },
        "user": { "type": "string" }
      }
    },
    "redis": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" }
      }
    },
    "rabbitmq": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" }
      }
    },
    "services": {
      "type": "object",
      "required": ["auth", "member", "scheduling", "access", "nutrition", "billing", "web"]
    }
  }
}
