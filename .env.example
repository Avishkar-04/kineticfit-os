# KineticFit OS Environment Configuration Example
# Copy to .env for local runtime execution

NODE_ENV=development
ORG_ID=01931668-8000-7000-8000-000000000001
HUB_ID=01931668-8000-7000-8000-000000000002
HUB_TIMEZONE=America/Los_Angeles
HUB_CURRENCY=USD

# Edge & Gateway Ports
NGINX_PORT=80
NGINX_SSL_PORT=443
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# Databases & Connection Pools
DATABASE_URL=postgresql://kinetic_app:kinetic_secret@localhost:6432/kineticfit?sslmode=disable
DATABASE_DIRECT_URL=postgresql://kinetic_admin:kinetic_secret@localhost:5432/kineticfit?sslmode=disable
PGBOUNCER_PORT=6432

# In-Memory Cache & Distributed Locks
REDIS_URL=redis://localhost:6379

# Event Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_MANAGEMENT_PORT=15672

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_ASSETS=kineticfit-assets
MINIO_BUCKET_EXPORTS=kineticfit-exports

# Security & Cryptography
JWT_SECRET=super-secret-kineticfit-key-for-development-only-min-32-chars
JWT_REFRESH_SECRET=super-secret-kineticfit-refresh-key-for-dev-only-min-32
ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Observability Ports
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200

# Service Internal Ports
AUTH_SERVICE_PORT=3001
MEMBER_SERVICE_PORT=3002
SCHEDULING_SERVICE_PORT=3003
NUTRITION_SERVICE_PORT=3004
BILLING_SERVICE_PORT=3005
ACCESS_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
WEB_PORT=5173
SIMULATOR_PORT=3010
PDF_EXPORT_PORT=3020
