{
  "name": "kineticfit-os",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "security:scan": "node scripts/scan-secrets.mjs",
    "db:migrate": "pnpm --filter @kineticfit/db run migrate",
    "db:seed": "pnpm --filter @kineticfit/db run seed"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "js-yaml": "^5.5.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
